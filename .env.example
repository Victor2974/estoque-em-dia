# Copie para .env.local (dev) e cadastre as mesmas variáveis no Vercel.

# Supabase (Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API do n8n — segredo que o n8n envia em "Authorization: Bearer <chave>"
# Gere uma com:  openssl rand -hex 32
N8N_API_KEY=

# (Opcional) webhook do n8n avisado a cada alteração feita pela API
N8N_WEBHOOK_URL=

# Assistente de IA do site (Google AI Studio)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# (Opcional) alternativa: Lovable AI Gateway, usado só sem GEMINI_API_KEY
LOVABLE_API_KEY=
