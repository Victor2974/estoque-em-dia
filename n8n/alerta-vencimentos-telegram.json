{
  "name": "Estoque em Dia — alerta diário de vencimentos (Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 7, "triggerAtMinute": 30 }] }
      },
      "id": "a1f1c2d3-0001-4c6e-9a01-000000000001",
      "name": "Todo dia 7h30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $vars.ESTOQUE_URL || 'https://SEU-SITE.vercel.app' }}/api/n8n/vencimentos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "dias", "value": "30" }] },
        "options": {}
      },
      "id": "a1f1c2d3-0002-4c6e-9a01-000000000002",
      "name": "Buscar vencimentos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f1c2d3-0003-4c6e-9a01-000000000003",
      "name": "Tem lote vencendo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "chatId": "SEU_CHAT_ID",
        "text": "={{ $json.mensagem }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f1c2d3-0004-4c6e-9a01-000000000004",
      "name": "Avisar no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, -20]
    }
  ],
  "connections": {
    "Todo dia 7h30": { "main": [[{ "node": "Buscar vencimentos", "type": "main", "index": 0 }]] },
    "Buscar vencimentos": { "main": [[{ "node": "Tem lote vencendo?", "type": "main", "index": 0 }]] },
    "Tem lote vencendo?": { "main": [[{ "node": "Avisar no Telegram", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Sao_Paulo" }
}
