    {
      "parameters": {
        "jsCode": "// Um item por lote em risco, com o pedido pronto para a IA.\nconst a = $input.first().json;\nif (!a.lotes || a.lotes.length === 0) {\n  return [{ json: { vazio: true, execucao_id: a.execucao_id, instrucoes: a.instrucoes, prompt: 'Sem lotes.' } }];\n}\nreturn a.lotes.map((l) => {\n  const { historico, ...numeros } = l;\n  return { json: {\n    execucao_id: a.execucao_id,\n    lote: l.lote,\n    instrucoes: a.instrucoes,\n    prompt: JSON.stringify({ hoje: a.hoje, lote: numeros, historico }, null, 2),\n  } };\n});"
      },
      "id": "a5833322-3077-4c37-a311-24eea696b983",
      "name": "Um item por lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        110
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "messages": {
          "messageValues": [
            {
              "message": "={{ $json.instrucoes }}"
            }
          ]
        }
      },
      "id": "2b46cbe3-c211-4ccb-a657-563ecad254f7",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        880,
        110
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0
        }
      },
      "id": "a7c14ea9-13c4-405b-87d1-d3a91b36c1dd",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        880,
        330
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lê a resposta da IA de cada lote e junta tudo num pedido só para o site.\n// O site confere de novo cada proposta; o que vier errado vira regra automática lá.\nfunction ler(j) {\n  let t = j?.text ?? j?.output ?? j?.choices?.[0]?.message?.content;\n  if (typeof t !== 'string') return null;\n  t = t.replace(/```json|```/g, '').trim();\n  const a = t.indexOf('{'), b = t.lastIndexOf('}');\n  if (a < 0 || b < a) return null;\n  try { return JSON.parse(t.slice(a, b + 1)); } catch (e) { return null; }\n}\nconst pedidos = $('Um item por lote').all().map((i) => i.json);\nconst respostas = $input.all().map((i) => i.json);\nconst propostas = [];\npedidos.forEach((p, i) => {\n  if (p.vazio) return;\n  const r = ler(respostas[i]) ?? {};\n  propostas.push({ lote: p.lote, acao: r.acao ?? 'INVALIDA', quantidade: r.quantidade ?? null,\n    desconto_pct: r.desconto_pct ?? null, justificativa: r.justificativa ?? '' });\n});\nreturn [{ json: { execucao_id: pedidos[0]?.execucao_id, propostas } }];"
      },
      "id": "4fa8a555-03bd-4d9a-97c9-26730e625de6",
      "name": "Juntar respostas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        110
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://estoque-em-dia-sigma.vercel.app/api/n8n/propostas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
